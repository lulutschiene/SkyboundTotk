# User-provided game data and generated game-derived outputs must never be published.
/game/
/build/
/dist/
# (per-version and set-aside copies: build_game.py --version, launcher/update.py; and save backups)
/game-*/
/build-*/
/build.*/
/save-backup*/
launcher/launcher.ini
*.nsp
*.xci
*.nca
*.nsz
*.xcz
*.keys
*.sav

# Switch dumps, keys, tickets and firmware, in any folder
*.ncz
*.tik
*.cert
*.cnmt
*.nso
*.nro
*.npdm
*.bin.keys
firmware/
nand/
sdmc/
bis/

# Extracted game files and the game's own formats, in any folder (a dump copied somewhere by mistake)
romfs/
exefs/
rtld
subsdk[0-9]
*.bfres
*.bntx
*.bfsha
*.sarc
*.pack
*.zs
*.byml
*.bgyml
*.bars
*.bwav
*.bfwav
*.bfstm
*.msbt
*.rsizetable

# Game-derived build outputs and a package's own data, in any folder
image.bin
image.json
rxcache/
user/
mods/
save-backups/
previous/

# Generated build tools and compiler output.
__pycache__/
*.pyc
*.o
*.obj
*.ilk
*.pdb
*.exe
*.dll
*.lib
*.exp
*.log
*.out
*.sha1
/a64-kit/tools/lld-link.exe
/a64-kit/lift/liba64emit.so

# Required, distributable wgpu-native runtime and import library.
!third_party/wgpu-native/lib/wgpu_native.dll
!third_party/wgpu-native/lib/wgpu_native.dll.lib
!third_party/sdl2/SDL2.dll

